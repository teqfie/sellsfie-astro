---
import { getImage } from 'astro:assets';
import logoWhite from '../assets/sellsfie-logo-white.png';
import logoDark from '../assets/sellsfie-logo.png';

interface Props {
  class?: string;
  eager?: boolean;
}

const { class: className = '', eager = false } = Astro.props;

/* One <img> whose source is swapped by the theme script, rather than two
   stacked images with one permanently display:none, which downloaded both
   logos and reported a 0x0 box to auditing tools. */
const [dark, light] = await Promise.all([
  getImage({ src: logoWhite, widths: [160, 320], format: 'webp', quality: 90 }),
  getImage({ src: logoDark, widths: [160, 320], format: 'webp', quality: 90 }),
]);

const ratio = logoWhite.width / logoWhite.height;
const height = 28;
---

<img
  data-logo
  src={dark.src}
  data-logo-dark={dark.src}
  data-logo-light={light.src}
  srcset={dark.srcSet.attribute}
  sizes="140px"
  width={Math.round(height * ratio)}
  height={height}
  alt="Sellsfie"
  decoding="async"
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class={className}
/>
