---
import Icon from '../Icon.astro';
import { useTranslations, toLang } from '../../i18n';

const lang = toLang(Astro.currentLocale);
const { t, tList } = useTranslations(lang);

const stats = tList<{ k: string; v: string }>('testimonial.stats');

/** Fixed sample series behind the little phone mock in the polaroid. */
const phoneBars = [3, 5, 4, 7, 6, 9, 8];
---

<section id="cases" class="py-14 sm:py-24">
  <div class="max-w-6xl mx-auto px-5">
    <div class="text-[11px] font-mono uppercase tracking-[0.25em] text-brand text-center">
      {t('testimonial.eyebrow')}
    </div>
    <h2 class="mt-3 font-display text-4xl sm:text-5xl font-extrabold text-white text-center">
      {t('testimonial.title')}
    </h2>

    <div class="mt-14 grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative">
          {/* Illustrated "polaroid" — all CSS shapes, no image in the original either. */}
          <div class="polaroid p-3 rounded-md w-[280px]">
            <div class="relative aspect-[4/5] rounded-sm overflow-hidden bg-gradient-to-br from-slate-300 to-slate-500">
              <div
                class="absolute inset-0"
                style="background: radial-gradient(120% 80% at 50% 30%, #F4D9A0 0%, #E2B377 40%, #8C5A2E 100%);"
              >
              </div>
              <div
                class="absolute left-1/2 top-[34%] -translate-x-1/2 h-24 w-20 rounded-[40%] bg-[#D9A86F]"
                style="box-shadow: inset -8px -10px 0 rgba(0,0,0,0.08);"
              >
              </div>
              <div class="absolute left-1/2 top-[28%] -translate-x-1/2 h-12 w-24 rounded-t-[60%] bg-[#1c1410]"></div>
              <div class="absolute left-[42%] top-[44%] h-1.5 w-1.5 rounded-full bg-[#1c1410]"></div>
              <div class="absolute left-[55%] top-[44%] h-1.5 w-1.5 rounded-full bg-[#1c1410]"></div>
              <div class="absolute left-1/2 top-[52%] -translate-x-1/2 h-2 w-7 border-b-2 border-[#1c1410] rounded-b-full"></div>
              <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 h-24 w-44 rounded-t-[40%] bg-[#0F141B] border-t-4 border-brand"></div>
              <div class="absolute right-3 bottom-4 w-16 h-24 rounded-md bg-[#06080A] border border-white/10 p-1.5 rotate-6">
                <div class="h-1 w-6 rounded-full bg-brand mb-1"></div>
                <div class="h-1 w-10 rounded-full bg-white/30 mb-1"></div>
                <div class="h-1 w-8 rounded-full bg-white/20 mb-2"></div>
                <div class="flex items-end gap-0.5 h-8">
                  {phoneBars.map((bar) => (
                    <div class="flex-1 bg-brand rounded-sm" style={`height:${10 * bar}%`}></div>
                  ))}
                </div>
                <div class="mt-1 text-[5px] font-mono text-brand text-center">৳5,00,740</div>
              </div>
              <div class="absolute top-3 left-3 text-[#fff] opacity-80">
                <Icon name="Spark" size={14} />
              </div>
            </div>
            <div class="mt-3 px-1 flex items-center justify-between">
              <span class="font-mono text-[10px] text-slate-700">{t('testimonial.tagline')}</span>
              <Icon name="Camera" size={12} class="text-slate-700" />
            </div>
          </div>
          <div class="absolute -top-3 left-8 h-5 w-16 bg-white/30 rotate-[-8deg] rounded-sm" style="backdrop-filter: blur(2px);"></div>
          <div class="absolute -inset-6 -z-10 rounded-3xl bg-brand/10 blur-3xl"></div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <Icon name="Quote" size={36} class="text-brand/70" />
        <blockquote class="mt-4 font-display text-2xl sm:text-3xl text-white leading-snug text-pretty">
          {t('testimonial.quotePre')}<span class="text-brand">{t('testimonial.quoteAccent')}</span>{t('testimonial.quotePost')}
        </blockquote>
        <div class="mt-6 flex items-center gap-4 flex-wrap">
          <div class="h-11 w-11 rounded-full bg-gradient-to-br from-brand/40 to-brand/10 grid place-items-center text-brand font-display font-bold">
            KH
          </div>
          <div>
            <div class="text-white font-semibold">{t('testimonial.who')}</div>
            <div class="text-xs text-slate-500 font-mono">{t('testimonial.whoTitle')}</div>
          </div>
          <div class="ml-auto flex items-center gap-3 text-xs text-slate-400">
            <div class="flex items-center gap-1">
              <Icon name="Star" size={14} class="text-brand" /> {t('testimonial.rating')}
            </div>
            <span class="h-3 w-px bg-white/10"></span>
            <span>{t('testimonial.merchants')}</span>
          </div>
        </div>
        <div class="mt-8 grid grid-cols-3 gap-3">
          {stats.map((stat) => (
            <div class="rounded-xl border border-white/5 bg-white/[0.02] p-3">
              <div class="font-display text-lg font-extrabold text-white">{stat.k}</div>
              <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500">{stat.v}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
