---
import Icon from './Icon.astro';
import { useTranslations, toLang } from '../i18n';

const lang = toLang(Astro.currentLocale);
const { t, tList } = useTranslations(lang);

const points = tList<string>('demo.points');

const WHATSAPP_URL =
  'https://wa.me/8801631776875?text=Hi!%20I%20would%20like%20to%20book%20a%20Sellsfie%20demo.';
---

<div class="relative min-h-screen">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 h-[640px] w-[640px] rounded-full blur-3xl opacity-40"
    style="background: radial-gradient(closest-side, rgba(56,206,0,0.35), transparent 70%);"
  >
  </div>
  <div aria-hidden="true" class="absolute inset-0 grid-bg opacity-60 pointer-events-none"></div>

  <section class="relative max-w-3xl mx-auto px-5 pt-32 sm:pt-40 pb-20">
    <div class="eyebrow text-brand">{t('demo.eyebrow')}</div>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl font-extrabold text-white text-balance">
      {t('demo.title')}
    </h1>
    <p class="mt-4 text-slate-400 max-w-xl">{t('demo.sub')}</p>

    <ul class="mt-8 space-y-3">
      {points.map((point) => (
        <li class="flex gap-3">
          <span class="mt-0.5 grid place-items-center h-5 w-5 rounded-md bg-brand/15 text-brand shrink-0">
            <Icon name="Check" size={11} strokeWidth={3} />
          </span>
          <span class="text-sm text-slate-300">{point}</span>
        </li>
      ))}
    </ul>

    <div class="mt-10 bento p-6 sm:p-8">
      <div class="eyebrow text-slate-400">{t('demo.cardEyebrow')}</div>
      <h2 class="mt-2 font-display text-2xl font-extrabold text-white">{t('demo.cardTitle')}</h2>
      <p class="mt-2 text-sm text-slate-400">{t('demo.cardSub')}</p>

      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brand mt-6 inline-flex items-center justify-center gap-2 h-12 px-6 rounded-xl font-display font-bold text-sm transition-all hover:scale-[1.02]"
      >
        {/* WhatsApp mark is a filled glyph, so it sits outside the stroked icon set. */}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.05 4.91A10 10 0 0 0 12.04 2C6.5 2 2 6.5 2 12.04c0 1.77.46 3.5 1.34 5.02L2 22l5.07-1.33a10 10 0 0 0 4.97 1.27h.01c5.53 0 10.03-4.5 10.03-10.03 0-2.68-1.04-5.2-2.93-7.09zM12.05 20.27h-.01a8.23 8.23 0 0 1-4.2-1.15l-.3-.18-3.01.79.8-2.94-.2-.31a8.23 8.23 0 0 1-1.27-4.44c0-4.55 3.7-8.25 8.25-8.25a8.21 8.21 0 0 1 5.83 2.42 8.21 8.21 0 0 1 2.42 5.83c0 4.55-3.7 8.23-8.31 8.23zm4.52-6.16c-.25-.13-1.46-.72-1.69-.8-.23-.08-.39-.13-.56.13-.17.25-.64.8-.78.97-.14.17-.29.19-.54.06-.25-.13-1.04-.38-1.99-1.22-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.43.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.13-.56-1.34-.77-1.84-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.84-.86 2.06s.88 2.39 1.01 2.55c.13.17 1.74 2.66 4.21 3.73.59.26 1.05.41 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.46-.6 1.66-1.18.21-.58.21-1.07.14-1.18-.06-.11-.23-.17-.48-.3z" />
        </svg>
        {t('demo.cta')}
        <Icon name="ArrowRight" size={14} strokeWidth={2.25} />
      </a>
    </div>
  </section>
</div>
