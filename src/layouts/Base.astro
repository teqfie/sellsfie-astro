---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { toLang, localizePath } from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** Root-relative path of this page, used to build the hreflang alternates. */
  path?: string;
}

const {
  title,
  description = 'The first true Business OS for Bangladesh. Manage inventory, automate couriers, and track every Taka from one beautiful dashboard.',
  path = '/',
} = Astro.props;

const lang = toLang(Astro.currentLocale);
const site = Astro.site ?? new URL('https://sellsfie.com');
const canonical = new URL(localizePath(path, lang), site).href;
---

<html lang={lang === 'bn' ? 'bn-BD' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(path, site).href} />
    <link rel="alternate" hreflang="bn" href={new URL(localizePath(path, 'bn'), site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(path, site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* The Bengali faces are ~180 KB and only Bengali pages need them. English
        pages show two Bengali characters (the language switcher label) and let
        those fall through to the system Bengali font instead of paying for a
        webfont download. */}
    {lang === 'bn' && (
      <>
        <link rel="preload" as="font" type="font/woff2" href="/fonts/noto-sans-bengali-bengali-400-normal.woff2" crossorigin />
        <link rel="preload" as="font" type="font/woff2" href="/fonts/noto-sans-bengali-bengali-700-normal.woff2" crossorigin />
        <style is:inline set:html={`
          @font-face{font-family:'Noto Sans Bengali';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/noto-sans-bengali-bengali-400-normal.woff2') format('woff2');unicode-range:U+0951-0952,U+0964-0965,U+0980-09FE,U+1CD0,U+1CD2,U+1CD5-1CD6,U+1CD8,U+1CE1,U+1CEA,U+1CED,U+1CF2,U+1CF5-1CF7,U+200C-200D,U+20B9,U+25CC,U+A8F1;}
          @font-face{font-family:'Noto Sans Bengali';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/noto-sans-bengali-bengali-500-normal.woff2') format('woff2');unicode-range:U+0951-0952,U+0964-0965,U+0980-09FE,U+1CD0,U+1CD2,U+1CD5-1CD6,U+1CD8,U+1CE1,U+1CEA,U+1CED,U+1CF2,U+1CF5-1CF7,U+200C-200D,U+20B9,U+25CC,U+A8F1;}
          @font-face{font-family:'Noto Sans Bengali';font-style:normal;font-weight:600;font-display:swap;src:url('/fonts/noto-sans-bengali-bengali-600-normal.woff2') format('woff2');unicode-range:U+0951-0952,U+0964-0965,U+0980-09FE,U+1CD0,U+1CD2,U+1CD5-1CD6,U+1CD8,U+1CE1,U+1CEA,U+1CED,U+1CF2,U+1CF5-1CF7,U+200C-200D,U+20B9,U+25CC,U+A8F1;}
          @font-face{font-family:'Noto Sans Bengali';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/noto-sans-bengali-bengali-700-normal.woff2') format('woff2');unicode-range:U+0951-0952,U+0964-0965,U+0980-09FE,U+1CD0,U+1CD2,U+1CD5-1CD6,U+1CD8,U+1CE1,U+1CEA,U+1CED,U+1CF2,U+1CF5-1CF7,U+200C-200D,U+20B9,U+25CC,U+A8F1;}
        `} />
      </>
    )}

    {/* Applied before first paint so a light-theme visitor never sees a dark flash. */}
    <script is:inline>
      try {
        if (localStorage.getItem('sellsfie-theme') === 'light') {
          document.documentElement.setAttribute('data-boot-theme', 'light');
        }
      } catch (e) {}
    </script>
    <style>
      html[data-boot-theme='light'] body {
        color: #0b1220;
        background: radial-gradient(1100px 600px at 18% -10%, #38ce001a, #0000 60%),
          radial-gradient(900px 500px at 100% 20%, #38ce000f, #0000 60%), #f6f7f4;
      }
    </style>
  </head>
  <body>
    <a class="skip-link btn-brand inline-flex items-center h-10 px-4 rounded-xl text-sm font-semibold" href="#main">
      Skip to content
    </a>
    <Nav path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer path={path} />

    <script is:inline>
      // Theme: dark is the default, "light" is remembered per browser.
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('sellsfie-theme');
        } catch (e) {}
        if (stored === 'light') document.body.classList.add('theme-light');
        document.documentElement.removeAttribute('data-boot-theme');

        function paintLogos(isLight) {
          document.querySelectorAll('[data-logo]').forEach(function (img) {
            var next = isLight ? img.dataset.logoLight : img.dataset.logoDark;
            if (next && img.getAttribute('src') !== next) {
              img.removeAttribute('srcset');
              img.src = next;
            }
          });
        }

        function paint(isLight) {
          paintLogos(isLight);
          document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
            btn.title = isLight ? 'Switch to dark' : 'Switch to light';
            var moon = btn.querySelector('[data-icon="moon"]');
            var sun = btn.querySelector('[data-icon="sun"]');
            if (!moon || !sun) return;
            moon.className = 'absolute transition-all duration-300 ' +
              (isLight ? 'opacity-0 rotate-90 scale-50' : 'opacity-100 rotate-0 scale-100');
            sun.className = 'absolute transition-all duration-300 ' +
              (isLight ? 'opacity-100 rotate-0 scale-100' : 'opacity-0 rotate-90 scale-50');
          });
        }

        paint(document.body.classList.contains('theme-light'));

        document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var isLight = document.body.classList.toggle('theme-light');
            try {
              localStorage.setItem('sellsfie-theme', isLight ? 'light' : 'dark');
            } catch (e) {}
            paint(isLight);
          });
        });
      })();
    </script>
  </body>
</html>
